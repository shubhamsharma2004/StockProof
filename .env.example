# Brandfetch Logo API client ID — free tier, get one at https://developers.brandfetch.com
# Used client-side to embed real company logos on the Stock Research hero card.
# Without it, Stockproof falls back to a generated letter avatar (never a broken image).
# Set the real value in .env.local (gitignored) — not here.
VITE_BRANDFETCH_CLIENT_ID=

# Market-data proxy base URL. Leave unset to use the proxy built into the
# Vite dev/preview server (same origin, /api). Set it only if you host the
# server/ proxy somewhere else, e.g. https://your-proxy.example.com/api
VITE_API_BASE_URL=

# Finnhub API key (server-side only — never prefix with VITE_, or it would be
# shipped to every visitor's browser). Free tier covers US markets only.
# Put the real value in .env.local, not here.
FINNHUB_API_KEY=

# ipoalerts API key (server-side only) — adds GMP trends and full company
# profiles to the IPO page. The IPO lists themselves come from NSE and work without it.
# Put the real value in .env.local, not here.
IPOALERTS_API_KEY=

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Saved evaluations and watchlist entries — a signed-in user can only
    // read/write their own subtree. Nothing else is client-accessible
    // (default deny).
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
